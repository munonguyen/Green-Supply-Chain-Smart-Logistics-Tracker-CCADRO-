# ==============================================================================
# CCADRO - Smart Green Logistics Tracker Environment Configuration
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Database (PostgreSQL + PostGIS)
POSTGRES_DB=ccadro
POSTGRES_USER=ccadro
POSTGRES_PASSWORD=ccadro_dev_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache / Live Fanout
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Application Profile
SPRING_PROFILES_ACTIVE=local

# Routing & External Adapters
ROUTING_PROVIDER=mock
ROUTING_BASE_URL=http://router.project-osrm.org
TRAFFIC_PROVIDER=mock
WEATHER_PROVIDER=mock

# Threshold & Behavior Defaults (BRD v4.0)
CCADRO_DEVIATION_YELLOW_METERS=50
CCADRO_DEVIATION_RED_METERS=200
CCADRO_REROUTING_MINIMUM_BENEFIT=0.10
CCADRO_REROUTING_COOLDOWN_SECONDS=300
CCADRO_REROUTING_HYSTERESIS_SECONDS=60
CCADRO_REROUTING_HARD_EVENT_BYPASS=true

# Multi-Criteria Optimization Weights (BRULE-05: Sum = 1.0)
CCADRO_OPTIMIZATION_CARBON_WEIGHT=0.40
CCADRO_OPTIMIZATION_TIME_WEIGHT=0.30
CCADRO_OPTIMIZATION_COST_WEIGHT=0.20
CCADRO_OPTIMIZATION_RISK_WEIGHT=0.10
CCADRO_OPTIMIZATION_PARETO_ENABLED=true

# GLEC v3 Carbon Accounting Configuration
CCADRO_CARBON_DEFAULT_TONNE_KM_FACTOR=0.080000
CCADRO_CARBON_DAF=1.05
CCADRO_CARBON_APPLY_DAF_ON_ACTUAL_GPS=false
CCADRO_CARBON_FACTOR_VERSION=GLEC_v3.0

# Demerit Points & Blacklist Review (M5)
CCADRO_DEMERIT_WARNING_THRESHOLD=10
CCADRO_DEMERIT_REVIEW_THRESHOLD=20

# Security (JWT)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

