# ==============================================================================
# CCADRO - Smart Green Logistics Tracker Environment Configuration
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Database (PostgreSQL + PostGIS)
POSTGRES_DB=ccadro
POSTGRES_USER=ccadro
POSTGRES_PASSWORD=ccadro_dev_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache / Live Fanout
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Application Profile
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
INFRA_BIND_ADDRESS=127.0.0.1

# Routing & External Adapters
ROUTING_PROVIDER=mock
ROUTING_BASE_URL=http://router.project-osrm.org
TRAFFIC_PROVIDER=mock
WEATHER_PROVIDER=mock

# Threshold & Behavior Defaults (BRD v4.0)
CCADRO_DEVIATION_YELLOW_METERS=50
CCADRO_DEVIATION_RED_METERS=200
CCADRO_REROUTING_MINIMUM_BENEFIT=0.10
CCADRO_REROUTING_COOLDOWN_SECONDS=300
CCADRO_REROUTING_HYSTERESIS_SECONDS=60
CCADRO_REROUTING_HARD_EVENT_BYPASS=true

# Multi-Criteria Optimization Weights (BRULE-05: Sum = 1.0)
CCADRO_OPTIMIZATION_CARBON_WEIGHT=0.40
CCADRO_OPTIMIZATION_TIME_WEIGHT=0.30
CCADRO_OPTIMIZATION_COST_WEIGHT=0.20
CCADRO_OPTIMIZATION_RISK_WEIGHT=0.10
CCADRO_OPTIMIZATION_PARETO_ENABLED=true

# GLEC v3 Carbon Accounting Configuration
CCADRO_CARBON_DEFAULT_TONNE_KM_FACTOR=0.080000
CCADRO_CARBON_DAF=1.05
CCADRO_CARBON_APPLY_DAF_ON_ACTUAL_GPS=false
CCADRO_CARBON_FACTOR_VERSION=GLEC_v3.0

# Demerit Points & Blacklist Review (M5)
CCADRO_DEMERIT_WARNING_THRESHOLD=10
CCADRO_DEMERIT_REVIEW_THRESHOLD=20

# Security (JWT)
JWT_SECRET=
JWT_SIGNER_KEY=
# Generated automatically by scripts/dev-start.sh for local development; use a secret manager in production.
JWT_EXPIRATION_MS=86400000

# Gateway CORS: exact trusted browser origins, comma-separated in deployments.
CCADRO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174


# Payment evidence / transactional mail (set the same internal token in both services)
CCADRO_INTERNAL_TOKEN=
CCADRO_LEGAL_NAME=
CCADRO_LEGAL_TAX_CODE=
CCADRO_LEGAL_ADDRESS=
CCADRO_LEGAL_SUPPORT_EMAIL=
CCADRO_LEGAL_RESPONSE_TIME=
NOTIFICATION_SERVICE_URL=http://localhost:8087
CCADRO_EMAIL_MODE=AUTO
CCADRO_BREVO_API_KEY=
CCADRO_EMAIL_SENDER=
CCADRO_EMAIL_SENDER_NAME=
CCADRO_PAYMENT_ALLOW_INSTANT_CONFIRM=false
CCADRO_PAYMENT_WEBHOOK_SECRET=
CCADRO_EVIDENCE_MAX_ATTEMPTS=10
CCADRO_EVIDENCE_RETRY_SECONDS=60
# Explicit opt-in for browser demo ledger; never enable for real payments
VITE_DEMO_MODE=false

# MongoDB Chat Service (local Mongo bound to loopback only; production uses authenticated URI)
MONGODB_PORT=27017
CHAT_MONGODB_URI=mongodb://localhost:27017/ccadro_chat
CHAT_PORT=8090
CHAT_BIND_ADDRESS=127.0.0.1
CHAT_SERVICE_URL=http://localhost:8090
IDENTITY_SERVICE_URL=http://localhost:8080
# Explicit demo only: live chat never confirms a local-only message as delivered
VITE_CHAT_DEMO_MODE=false

# Socket.IO endpoint routed by Gateway (single Chat instance)
CHAT_SOCKET_PORT=8091
CHAT_SOCKET_URL=ws://127.0.0.1:8091
CHAT_SOCKET_HTTP_URL=http://127.0.0.1:8091
VITE_CHAT_SOCKET_URL=http://localhost:8888
CHAT_SOCKET_BIND_ADDRESS=127.0.0.1
CCADRO_CHAT_SOCKET_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Standalone infrastructure registry; dev-start enables clients by default.
EUREKA_PORT=8761
EUREKA_BIND_ADDRESS=127.0.0.1
EUREKA_START_LOCAL=true
EUREKA_CLIENT_ENABLED=true
EUREKA_SERVER_URL=http://127.0.0.1:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=localhost
# Set a unique suffix per process when using multiple replicas of one service.
# EUREKA_INSTANCE_ID=replica-1
