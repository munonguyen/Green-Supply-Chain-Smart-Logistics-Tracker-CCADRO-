<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ccadro</groupId>
    <artifactId>ccadro-backend-aggregator</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ccadro-backend-aggregator</name>
    <description>CCADRO Green Logistics Tracker - Microservices Aggregator (BookShop Pattern)</description>

    <properties>
        <POSTGRES_HOST>localhost</POSTGRES_HOST>
        <POSTGRES_PORT>5433</POSTGRES_PORT>
        <POSTGRES_DB>ccadro</POSTGRES_DB>
        <POSTGRES_USER>ccadro</POSTGRES_USER>
        <POSTGRES_PASSWORD>ccadro_dev_secret</POSTGRES_PASSWORD>
        <flyway.version>10.10.0</flyway.version>
    </properties>

    <modules>
        <module>eureka-server</module>
        <module>api-gateway</module>
        <module>identity-service</module>
        <module>asset-service</module>
        <module>shipment-service</module>
        <module>routing-service</module>
        <module>tracking-service</module>
        <module>carbon-service</module>
        <module>incident-service</module>
        <module>notification-service</module>
        <module>payment-service</module>
        <module>hub-shipper-service</module>
        <module>chat-service</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>${flyway.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <url>jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}</url>
                    <user>${POSTGRES_USER}</user>
                    <password>${POSTGRES_PASSWORD}</password>
                    <locations>
                        <location>filesystem:db/migration</location>
                    </locations>
                    <baselineOnMigrate>true</baselineOnMigrate>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>${flyway.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>42.7.4</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
