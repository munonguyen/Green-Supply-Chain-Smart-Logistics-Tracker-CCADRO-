<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ccadro</groupId>
    <artifactId>ccadro-backend-aggregator</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ccadro-backend-aggregator</name>
    <description>CCADRO Green Logistics Tracker - Microservices Aggregator (BookShop Pattern)</description>

    <modules>
        <module>api-gateway</module>
        <module>identity-service</module>
        <module>asset-service</module>
        <module>shipment-service</module>
        <module>routing-service</module>
        <module>tracking-service</module>
        <module>carbon-service</module>
        <module>incident-service</module>
        <module>notification-service</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Spotless: Clean Code Code Style & Unused Imports Formatter -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>2.43.0</version>
                    <configuration>
                        <java>
                            <removeUnusedImports />
                        </java>
                    </configuration>
                </plugin>

                <!-- JaCoCo: Test Coverage & Clean Code Quality Metric -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.12</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
